# =====================================================================================================================
#  ldap.env  -  sign-in with Windows usernames and passwords (the company directory, LDAP / Active Directory)
# =====================================================================================================================
#
#  HOW TO USE THIS FILE (IT):
#    1. Copy this file to "ldap.env" in the same folder (the project folder, next to README.md).
#       ldap.env is NOT stored in git: it holds the service account password and lives only on the server.
#    2. Replace every value marked  <IT: fill this in ...>  with the real value (remove the < and > too).
#    3. Test the settings without switching anything on:
#           cd backend
#           ..\.venv\Scripts\python.exe -m flask --app wsgi check-ldap --username U12345
#       (use a real Windows username). Every line must say OK.
#    4. Recommended: fill in BREAK_GLASS_USERNAME below (it is empty, so switched off, until you do), then create
#       the emergency account and its password:
#           ..\.venv\Scripts\python.exe -m flask --app wsgi set-break-glass-password
#    5. Change AUTH_MODE below from local to ldap and restart the app.
#
#  Rules for writing values:
#    - One setting per line:  NAME=value   (no spaces around the = sign).
#    - Lines that start with # are notes and are ignored.
#    - If a value contains a #, a space or a quote, put it in single quotes:  LDAP_BIND_PASSWORD='my#pass word'
#    - A setting given in the server's real environment variables wins over this file; this file wins over .env
#      (for the server and for every "flask --app wsgi ..." command alike).
#
#  Who can use the system: only people an ADMIN has added on the "Users & access" page (by their Windows
#  username, e.g. U12345), and only while they are active there. Roles and departments are given in the app, not in
#  the directory. A person IT disables in the directory cannot sign in any more.
# =====================================================================================================================


# ---- 1. Switch -------------------------------------------------------------------------------------------------------
# local = the app's own passwords (how the demo works today).
# ldap  = Windows usernames and passwords, checked by the company directory.
# Leave it on local until check-ldap (step 3 above) says "All checks passed".
AUTH_MODE=local


# ---- 2. Where the directory is ---------------------------------------------------------------------------------------
# IT: fill this in. The name of the directory server (domain controller). Name only: no ldap:// or ldaps://.
# For a backup server, list several separated by commas; the app tries them in order:
#   LDAP_SERVER=dc01.company.local,dc02.company.local
# The name must be the one written on the server's certificate (usually the full name, not an IP address).
LDAP_SERVER=<IT: fill this in, e.g. dc01.company.local>

# The port. 636 for ldaps (the usual choice), 389 for starttls.
LDAP_PORT=636

# How the connection is encrypted:  ldaps  (encrypted from the start, port 636)  or  starttls  (port 389, then
# encrypted before any password is sent). Plain unencrypted LDAP is not allowed.
LDAP_SECURITY=ldaps

# IT: fill this in. The full path of the company CA certificate file (the certificate that signed the domain
# controllers' certificates). .cer, .crt or .pem; both the Base-64 and the binary (DER) forms work.
# A relative path is read from the project folder.
LDAP_CA_FILE=<IT: fill this in, e.g. C:\CapabilityPortfolio\certs\company-root-ca.cer>


# ---- 3. Where the user accounts are ----------------------------------------------------------------------------------
# IT: fill this in. The folder (OU) in the directory that holds the staff accounts. Accounts in sub-folders are
# found too. To search the whole domain use just the DC parts, e.g. DC=company,DC=local
LDAP_BASE_DN=<IT: fill this in, e.g. OU=Staff,DC=company,DC=local>


# ---- 4. The service account (read-only) ------------------------------------------------------------------------------
# IT: fill this in. A read-only directory account the app uses to find people before checking their password.
# Either its full name (DN) or its sign-in name, for example:
#   LDAP_BIND_DN=CN=svc-cpc,OU=Service Accounts,DC=company,DC=local
#   LDAP_BIND_DN=svc-cpc@company.local
# Give it a password that does not expire, or remember to update it here when it changes.
LDAP_BIND_DN=<IT: fill this in, e.g. svc-cpc@company.local>

# IT: fill this in. The service account's password. Never shown by the app or written to its logs.
LDAP_BIND_PASSWORD=<IT: fill this in>


# ---- 5. Usernames (normally leave as they are) ------------------------------------------------------------------------
# The directory field that holds the Windows username. sAMAccountName is the standard one in Active Directory.
LDAP_USERNAME_ATTRIBUTE=sAMAccountName

# The directory field with the person's full name, shown in the app.
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# What a Windows username looks like: the letter U followed by digits (U12345). Upper or lower case both work.
# People may also type COMPANY\U12345 or U12345@company.local; the app removes the domain part.
LDAP_USERNAME_PATTERN=^U[0-9]+$


# ---- 6. Timeouts -----------------------------------------------------------------------------------------------------
# How many seconds to wait for the directory before trying the next server or giving up (1 to 60).
# When the directory does not answer, people see "The company directory cannot be reached".
LDAP_TIMEOUT_SECONDS=5

# Sign-out after this many minutes without using the app.
SESSION_IDLE_MINUTES=30

# Sign-out after this many hours, even when the app is in use. Someone IT disables in the directory keeps an
# open session at most this long; an ADMIN who deactivates them in "Users & access" ends it at once.
SESSION_ABSOLUTE_HOURS=12


# ---- 7. Emergency (break-glass) admin --------------------------------------------------------------------------------
# One local ADMIN account for when the directory is down and nobody can sign in. Its password is kept in the app
# (not in the directory) and is never sent to the directory. Every use is written to the app's log as a WARNING.
# The owner chose the name AILAB (30 Oct 2026). Leave it empty ( BREAK_GLASS_USERNAME= ) for no emergency account.
# The name must not look like a Windows username (not U followed by digits) and must not start with "mock.".
# Then create the account and set its password on the server (at least 16 characters) and seal it (DBA or IT safe):
#     ..\.venv\Scripts\python.exe -m flask --app wsgi set-break-glass-password
# The password is typed there only (hidden, twice); it is never written in this file or any other.
# Only a password set with that command works; running it again sets a new one and signs the account out.
BREAK_GLASS_USERNAME=AILAB
