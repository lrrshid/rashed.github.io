# Capability Portfolio Command - local settings. Copy to .env (never commit real passwords).
# Directory (LDAP) sign-in settings go in ldap.env instead (see ldap.env.example).

# demo   = local SQLite file with the brochure-shaped demo data (created and seeded on first start)
# oracle = the shared Oracle database (schema applied by the DBA; see docs/oracle-migration.md)
APP_PROFILE=demo
APP_ENV=local
APP_TIMEZONE=Asia/Dubai
LOG_LEVEL=INFO

# Demo database file (relative to the project folder).
DEMO_DB_PATH=data/cpc-demo.db
# DEMO_SKIP_SEED=true

# Sign-in: local (passwords in the app; on a local demo the mock.* accounts) or ldap (company directory).
AUTH_MODE=local

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# SESSION_COOKIE_SECURE=false   # only for plain-HTTP testing; true by default outside APP_ENV=local
# TRUSTED_PROXY_COUNT=0

# Scheduled reports are written here (the system is air-gapped: no e-mail). A local folder or a shared folder on the
# local network, e.g. \\fileserver\CPC-Reports. Relative paths are relative to the project folder.
# REPORTS_OUTPUT_DIR=data/reports

# ---- oracle profile ----
# ORACLE_DSN=dbhost.company.local:1521/CPCPDB
# ORACLE_USER=CPC_APP
# ORACLE_PASSWORD=<set-on-the-server>
# ORACLE_SCHEMA=CPC_OWNER
# ORACLE_POOL_MAX=5
# ORACLE_TIMEOUT_SECONDS=10
# ORACLE_THICK_MODE=false
