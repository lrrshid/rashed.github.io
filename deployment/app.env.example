# Capability Portfolio Command - the settings on the VM (/opt/cpc/app.env). install.sh writes this file on the first
# install from the answers it asks (and a new SETTINGS_KEY); this example explains every line. chmod 600.
# Never commit app.env and never paste its values into tickets, chat or logs. After a change:
#   /opt/cpc/scripts/app.sh restart
# Directory (Windows) sign-in is set up from the website (Settings > Sign-in and directory), or the old way in ldap.env.

# ---- the system (do not change) ----
APP_ENV=production
APP_TIMEZONE=Asia/Dubai
LOG_LEVEL=INFO
# Exactly one proxy in front of the app: the VM's nginx (or the bundled nginx container). If another proxy or load
# balancer is put in front of nginx, this number and the X-Forwarded-* headers of the nginx site change together.
TRUSTED_PROXY_COUNT=1

# ---- capacity ----
# Requests served at the same time (one process, this many threads). 8 suits 2-4 cores.
APP_THREADS=8

# ---- sign-in ----
# local = passwords kept in the app (until the directory is ready); ldap = Windows passwords.
AUTH_MODE=local
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Many users behind one company address (NAT) may need a higher per-address limit.
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=20

# ---- scheduled reports ----
# Written under the data folder (backed up by scripts/app.sh backup).
REPORTS_OUTPUT_DIR=/app/data/reports

# ---- the key that encrypts the passwords saved in Settings (AES-256-GCM; docs/SETTINGS.md) ----
# install.sh makes one; another with: /opt/cpc/scripts/app.sh new-key. Keep a copy with the backups, never in Git.
SETTINGS_KEY=<44 characters from: /opt/cpc/scripts/app.sh new-key>

# ---- the database: ONE of the two blocks ----
# A. Built-in: one file in /opt/cpc/data (the profile is called demo, but with APP_ENV=production it starts empty:
#    no demo records, no mock accounts). The first administrator: scripts/app.sh flask setup-database --admin <name>.
#    Moving to Oracle later: Settings > Database (docs/SETTINGS.md), then block B here and a restart.
APP_PROFILE=demo
DEMO_DB_PATH=/app/data/cpc.db

# B. Oracle (from the DBA; docs/oracle-migration.md). An EMPTY schema: the app refuses to start on the demo data.
# APP_PROFILE=oracle
# ORACLE_DSN=<dbhost.company.local:1521/CPCPDB>
# ORACLE_USER=CPC_APP
# ORACLE_PASSWORD=<runtime account password>
# ORACLE_SCHEMA=CPC_OWNER
# Connections the app keeps open (agree the number with the DBA): at least APP_THREADS.
# ORACLE_POOL_MAX=8
# ORACLE_TIMEOUT_SECONDS=10
# Wallet / TCPS only if the DBA requires it (files under /opt/cpc/data/oracle):
# ORACLE_CONFIG_DIR=/app/data/oracle
# ORACLE_WALLET_LOCATION=/app/data/oracle
# ORACLE_WALLET_PASSWORD=<wallet password>
