# Capability Portfolio Command - settings on the VM. Copy to app.env (chmod 600) and fill every <...>.
# Never commit app.env and never paste its values into tickets, chat or logs.
# Directory (LDAP) sign-in settings go in ldap.env (copy ldap.env.example; see ldap/README.md).

# ---- the system (do not change) ----
APP_PROFILE=oracle
APP_ENV=production
APP_TIMEZONE=Asia/Dubai
LOG_LEVEL=INFO
# Exactly one proxy in front of the app: the nginx container. If another proxy or load balancer is put in front of
# nginx, this number and the X-Forwarded-* headers in nginx/nginx.conf must be revisited together.
TRUSTED_PROXY_COUNT=1

# ---- Oracle (from the DBA; docs/oracle-migration.md) ----
ORACLE_DSN=<dbhost.company.local:1521/CPCPDB>
ORACLE_USER=CPC_APP
ORACLE_PASSWORD=<runtime account password>
ORACLE_SCHEMA=CPC_OWNER
# Connections the app keeps open (agree the number with the DBA). At least APP_THREADS; the daily commands
# (scripts/app.sh flask ...) open a few more for a moment.
ORACLE_POOL_MAX=8
ORACLE_TIMEOUT_SECONDS=10
# Wallet / TCPS only if the DBA requires it (files under data/oracle, i.e. /app/data/oracle in the container):
# ORACLE_CONFIG_DIR=/app/data/oracle
# ORACLE_WALLET_LOCATION=/app/data/oracle
# ORACLE_WALLET_PASSWORD=<wallet password>

# ---- capacity ----
# Requests served at the same time (one process, this many threads). 8 suits 2-4 cores.
APP_THREADS=8

# ---- sign-in ----
# local = passwords kept in the app (until the directory is ready); ldap = Windows passwords (ldap.env).
# The mock demo accounts are never created here: the first administrator is made with
#   bash ./scripts/app.sh flask create-user --username <name> --role SYS_ADMIN
AUTH_MODE=local
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Many users behind one company address (NAT) may need a higher per-address limit.
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=20

# ---- scheduled reports ----
# Written under the data folder (back it up). Leave as is unless IT mounts a shared folder into the container.
REPORTS_OUTPUT_DIR=/app/data/reports
