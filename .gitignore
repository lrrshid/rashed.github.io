# Local settings and secrets: never committed. Templates: .env.example, ldap.env.example.
.env
ldap.env
oracle-local.env

# The local encryption keys of Settings > connections (demo and test profiles make them on first use)
data/settings.key
data/settings-test.key

# Demo / test databases (rebuilt from the seed on first start)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/files/
data/backups/

# Python environment (recreated by scripts/run_dev.ps1)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# test artifacts
test-results/
playwright-report/

# editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
data/files-test/
data/reports/

# Offline Python packages for the air-gapped network (built by scripts/build_wheelhouse.ps1)
wheelhouse/
data/reports-test/

# Temporary work folder (never committed)
.work/

# Offline deployment (internet-to-local.md): bundles, and what exists only on a VM (settings, data, keys, backups)
dist/
deployment/app.env
deployment/.env
deployment/data/
deployment/backups/
deployment/certs/*
!deployment/certs/README.md
deployment/install.conf
deployment/ldap/*
!deployment/ldap/README.md

